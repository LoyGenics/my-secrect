{
  "name": "my-secrect",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Digital Vault — local-first, E2EE",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/crypto-vectors/ tests/sync-conflicts/ tests/compatibility/ tests/recovery/ tests/end-to-end/ && npm run test:real",
    "test:mirrors": "node --test tests/crypto-vectors/ tests/sync-conflicts/ tests/compatibility/ tests/recovery/ tests/end-to-end/",
    "test:real": "tsx --test --test-concurrency=1 packages/storage/tests/upload.real.test.mts packages/import-export/tests/backup-corruption.real.test.ts packages/sync/tests/real-sync-client-import.test.ts packages/sync/tests/sync-client-pull.import.ts packages/core/tests/sharing-proposal.test.mjs packages/crypto-adapters/tests/libsodium-adapter.import.test.mjs apps/desktop/portable-restore.test.ts apps/desktop/portable-restore-guards.test.ts apps/extension/vault-ext-restore.test.ts apps/mobile/vault-restore.test.ts apps/extension/tests/domain.test.ts",
    "test:media-e2e": "tests/media-e2e/run.sh",
    "test:rails": "cd apps/api && bundle exec rspec",
    "test:crypto-core": "cd native/crypto-core && cargo test",
    "dev:desktop": "npm --workspace apps/desktop run dev"
  },
  "devDependencies": {
    "libsodium-wrappers-sumo": "0.7.15",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=20"
  }
}
