{
  "name": "@my-secrect/ui",
  "version": "0.1.0",
  "private": true,
  "description": "My Secret design system: design tokens (light/dark), accessible React components on Radix primitives, and theme helpers. Web/desktop only for components; React Native consumes tokens only.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./theme": "./src/theme.ts"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@my-secrect/i18n": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
