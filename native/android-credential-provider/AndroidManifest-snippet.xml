<?xml version="1.0" encoding="utf-8"?>
<!--
  MERGE INTO the Android app module's AndroidManifest.xml, inside
  <application>. This file is a snippet, not a manifest — it is not
  compiled on its own. Requires API 34+ (Android 14): the Credential
  Manager provider service does not exist below that; Android < 14 needs
  the separate AutofillService integration (not implemented yet).

  Verify the intent-filter action and meta-data names against the
  androidx.credentials version in use at integration time (see
  provider-build.gradle.kts). The service must be exported and protected
  by BIND_CREDENTIAL_PROVIDER_SERVICE so only the system can bind to it.
-->
<service
    android:name=".provider.MySecrectCredentialProviderService"
    android:exported="true"
    android:label="my-secrect"
    android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
    <intent-filter>
        <action android:name="android.service.credentials.CredentialProviderService" />
    </intent-filter>
    <meta-data android:name="android.credentials.TYPE_PASSWORD" android:value="true" />
    <meta-data android:name="android.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" android:value="true" />
</service>
