<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Marks this target as an AutoFill credential provider. -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<!-- Shared container between the main app and this extension. Must match
	     the group in the MAIN APP target's entitlements exactly, and the group
	     must be enabled for the App ID in the Apple Developer portal. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.loygenics.my-secrect</string>
	</array>
	<!-- Associated Domains for passkey / password AutoFill matching.
	     TODO: replace the placeholder with each real relying-party domain
	     the vault should offer credentials for, one webcredentials: entry
	     per domain. The domain must also serve an apple-app-site-association
	     file listing this app. Until then this entitlement is a placeholder
	     and AutoFill matching will not work. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:TODO-REPLACE-WITH-YOUR-DOMAIN</string>
	</array>
</dict>
</plist>
