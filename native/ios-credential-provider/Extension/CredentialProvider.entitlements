<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Marks this target as an AutoFill credential provider. -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<!-- vault.db lives in this group's container (specs/mobile-local-store.md §1).
	     The app target carries the same group (added by the config plugin). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.loygenics.my-secrect</string>
	</array>
	<!-- LSK and device-unlock keys (contract §3, §4). Must equal the
	     MySecrectKeychainAccessGroup value in Info.plist. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.loygenics.my-secrect.shared</string>
	</array>
	<!-- No Associated Domains: a password provider fills any matching site
	     without them. See README.md "Associated Domains" for the build-time
	     setting used if the app ever needs webcredentials for its own domain. -->
</dict>
</plist>
