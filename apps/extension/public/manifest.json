{
  "manifest_version": 3,
  "name": "my-secrect",
  "version": "0.1.0",
  "description": "Personal Digital Vault — local-first, end-to-end encrypted. Autofill only what you choose.",
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": [],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "my-secrect",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/index.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
