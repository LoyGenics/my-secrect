source 'https://rubygems.org'
# Accept any Ruby 3.3 patch. CI installs the 3.3 line and ruby:3.3-slim
# is the current 3.3 image (3.3.13), which an exact 3.3.0 pin rejects.
ruby '~> 3.3.0'

gem 'rails', '~> 7.1'
gem 'pg', '~> 1.5'          # PostgreSQL — metadata + ciphertext only, never plaintext
gem 'puma', '~> 6.4'
gem 'sidekiq', '~> 7.2'     # background jobs: orphan cleanup, quota, retention. NEVER decrypts vault content.
gem 'connection_pool', '~> 2.4' # sidekiq 7.3 is incompatible with connection_pool 3.x (scheduler thread crashes)
gem 'redis', '~> 5.0'
gem 'webauthn', '~> 3.0'    # account auth via passkeys — separate from vault unlock
gem 'rotp', '~> 6.3'       # TOTP MFA (RFC 6238) — account second factor, never vault unlock
gem 'jwt', '~> 3.1'        # verify Google/Apple ID tokens (RS256, JWKS); already locked via webauthn
gem 'rbnacl', '~> 7.1'     # Ed25519 recovery-key signatures (RbNaCl::VerifyKey)
gem 'aws-sdk-s3', '~> 1.0'  # S3 / R2 / MinIO presigned URLs (client uploads ciphertext directly)
gem 'rack-cors'
gem 'stripe', '~> 21.0'    # Hosted web Checkout + verified billing webhooks
gem 'rack-attack', '~> 6.7' # rate-limit auth + recovery endpoints (see config/initializers/rack_attack.rb)
gem 'bootsnap', require: false

group :development, :test do
  gem 'rspec-rails', '~> 6.1'
  gem 'factory_bot_rails'
end

group :development do
  gem 'listen'
end
