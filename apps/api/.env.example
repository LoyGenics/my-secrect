# Copy to .env — NEVER commit a real .env. No secrets are checked into git.
RAILS_ENV=development
PORT=3000
POSTGRES_USER=vault
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vault_development
DATABASE_URL=postgres://vault:CHANGE_ME_STRONG_RANDOM@localhost:5432/vault_development
REDIS_URL=redis://localhost:6379/0
RAILS_MASTER_KEY=CHANGE_ME_GENERATE_WITH_rails_secret
# S3-compatible storage (MinIO locally, R2/S3 in cloud). Client uploads ciphertext directly.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vault-blobs
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# WebAuthn (passkeys) — relying party must match the real origin in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=my-secrect
WEBAUTHN_ORIGIN=http://localhost:3000
# CORS: desktop (Tauri) + web client origins only. Tighten in production.
CORS_ORIGINS=http://localhost:1420,http://localhost:3000
# Session tokens: short-lived Bearer tokens issued after passkey verification.
SESSION_TOKEN_TTL_SECONDS=3600
# Sign-up email verification codes (config/initializers/action_mailer.rb).
# REQUIRED in production — the API refuses to boot without all five.
# STARTTLS is mandatory; set SMTP_TLS_MODE=tls for implicit TLS (port 465).
# Development ignores these and writes mail to tmp/mails/<address> instead.
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=my-secrect <no-reply@example.com>
# SMTP_TLS_MODE=starttls
# Dev/test only: deliver mail as files into this directory (the e2e harness
# sets it to read codes like an inbox). Ignored in production.
# MAIL_FILE_DIR=tmp/mails
