# Build-time settings for the desktop app (Vite reads VITE_* at build time;
# copy to apps/desktop/.env.local). Placeholders only — never commit values.

# Default account server. Users can still change it; with neither this nor a
# saved URL the app asks for one before sign-in. Dev API: http://localhost:3301/api
VITE_MY_SECRET_API_BASE_URL=

# "Continue with Google" on desktop: a Google OAuth client of type
# "Desktop app" (loopback redirect, PKCE). Google issues such clients a
# client secret that it documents as NOT confidential for installed apps and
# still requires at the token endpoint. The API must also accept this client
# id as an ID-token audience. Leave empty to hide the Google button on desktop.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
