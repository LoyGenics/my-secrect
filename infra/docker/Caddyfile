# TLS reverse proxy. The site address comes from SITE_ADDRESS (compose env;
# your real domain in production, `localhost` for a local run with Caddy's
# internal CA).
# Caddy obtains a Let's Encrypt certificate automatically when the domain
# points at this host. Port 3000 is not published; use this proxy on
# 80/443 instead of http://localhost:3000.
{$SITE_ADDRESS} {
  reverse_proxy api:3000
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
  }
}

# Public S3 API (MinIO) for presigned PUT/GET of ciphertext chunks. Host-based
# routing, not a path prefix: a SigV4 presigned URL signs the Host header, and
# Caddy forwards the client's Host unchanged, so the signature the API made
# against S3_PUBLIC_ENDPOINT (https://s3.<SITE_ADDRESS>[:port]) verifies at MinIO.
# Only ciphertext chunks pass through here. CORS preflight is answered by
# MinIO itself (MINIO_API_CORS_ALLOW_ORIGIN = CORS_ORIGINS).
# SITE_ADDRESS must be a bare host name (no scheme, no port).
s3.{$SITE_ADDRESS} {
  reverse_proxy minio:9000
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}
