# MY SECRET — Docker Compose environment template (Phase G, 17 Nov 2026).
# Copy to .env and fill in REAL secrets. NEVER commit .env.
# Every value below is a PLACEHOLDER — none of these will work as-is.
# Generate secrets with: openssl rand -hex 32
#
# NOTE: this file did not exist before Phase G, even though
# infra/docker/README.md and infra/self-host/README.md both told the user
# to run `cp .env.example .env`. That instruction was broken until now.
# See docs/deployment.md for the full validation checklist.
#
# Compose refuses to start when any required variable is unset or empty
# (${VAR:?}). Required names: POSTGRES_PASSWORD, RAILS_MASTER_KEY,
# S3_ACCESS_KEY, S3_SECRET_KEY.
# Published host ports are Caddy 80 and 443 only. api:3000 and minio:9000
# are Docker DNS names, not host ports.

# Postgres password for the `vault` user (required).
POSTGRES_PASSWORD=CHANGE_ME

# Object storage (MinIO in compose; R2/S3 in cloud). These are the MinIO
# root credentials and the S3 credentials for the API and the worker.
# Both keys are required. A real MinIO root password must be at least 8 characters.
# S3_BUCKET may be omitted; compose defaults it to vault-blobs.
S3_BUCKET=vault-blobs
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# Rails encrypted credentials key (required). The API will not boot without it.
# Generate: openssl rand -hex 32
RAILS_MASTER_KEY=CHANGE_ME

# WebAuthn / passkey relying party. MUST match the public hostname clients use.
# TLS enters through Caddy (443). The API is not published on host port 3000.
WEBAUTHN_RP_ID=vault.example.com
WEBAUTHN_ORIGIN=https://vault.example.com

# CORS: exact origins of the web client / desktop app, comma-separated.
# Never use `*` in production.
CORS_ORIGINS=https://vault.example.com
