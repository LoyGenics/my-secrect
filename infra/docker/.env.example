# MY SECRET — Docker Compose environment template (Phase G, 17 Nov 2026).
# Copy to .env and fill in REAL secrets. NEVER commit .env.
# Every value below is a PLACEHOLDER — none of these will work as-is.
# Generate secrets with: openssl rand -hex 32
#
# NOTE: this file did not exist before Phase G, even though
# infra/docker/README.md and infra/self-host/README.md both told the user
# to run `cp .env.example .env`. That instruction was broken until now.
# See docs/deployment.md for the full validation checklist.

# Postgres superuser password for the `vault` user (compose: db service).
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Object storage (MinIO in compose; R2/S3 in cloud). MinIO root credentials
# double as the S3 credentials the API uses.
S3_BUCKET=vault-blobs
S3_ACCESS_KEY=CHANGE_ME_minio_root_user
S3_SECRET_KEY=CHANGE_ME_minio_root_password_min_8_chars

# Rails encrypted credentials key. The API will not boot without it.
# Generate: openssl rand -hex 32
RAILS_MASTER_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# WebAuthn / passkey relying party. MUST match the real public domain.
# Local testing only: localhost / http://localhost:3000.
WEBAUTHN_RP_ID=vault.example.com
WEBAUTHN_ORIGIN=https://vault.example.com

# CORS: exact origins of the web client / desktop app, comma-separated.
# Never use `*` in production.
CORS_ORIGINS=https://vault.example.com
