# DEV / EXAMPLE ONLY. Copy to .env and replace every CHANGE_ME with a real
# random value. NEVER commit .env.
# Fail-fast, in two layers:
#   1. compose refuses to start if any required variable below is unset or
#      empty (${VAR:?} in docker-compose.yml);
#   2. the API and worker refuse to BOOT in production if a secret is still a
#      CHANGE_ME placeholder, SECRET_KEY_BASE is shorter than 64 characters,
#      S3_SECRET_KEY is shorter than 16, CORS_ORIGINS contains `*`, or any
#      S3_* value is missing/invalid (apps/api/config/environments/production.rb,
#      config/initializers/storage_config.rb). There are no code defaults.
# Test/dev values live only in apps/api/spec/support/storage_env.rb (random,
# non-secret). smoke.sh, backup-restore-proof.sh, verify-restore.sh and
# verify-web-csp.sh generate their own throwaway random env and do not read
# this file.

# openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME

# Object storage. MinIO root credentials == the S3 credentials the API uses.
# S3_SECRET_KEY: openssl rand -hex 32 (the API requires >= 16 characters).
S3_BUCKET=vault-blobs
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# Public origin of the S3 API, used ONLY to sign presigned URLs handed to
# clients. Compose publishes MinIO through Caddy at s3.<SITE_ADDRESS>, so
# this is https://s3.<SITE_ADDRESS>[:HTTPS_PORT if not 443]. You also need a
# DNS record (or wildcard) for s3.<SITE_ADDRESS> pointing at this host.
S3_PUBLIC_ENDPOINT=https://s3.vault.example.com

# Rails production signing/encryption secret (no credentials.yml.enc exists
# in this repo, so this is what Rails uses). openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME

# Caddy site address: your domain in production (automatic Let's Encrypt),
# or `localhost` for a local run (Caddy internal CA).
SITE_ADDRESS=vault.example.com
# Host ports Caddy publishes (defaults 80/443).
HTTP_PORT=80
HTTPS_PORT=443

# WebAuthn relying party. MUST match the public origin clients use.
WEBAUTHN_RP_ID=vault.example.com
WEBAUTHN_ORIGIN=https://vault.example.com

# CORS: exact origins, comma-separated. Never `*`. Also applied to the S3
# endpoint (MinIO) so browsers can PUT/GET presigned URLs. The web client
# served by Caddy is same-origin; list other client origins only if used.
CORS_ORIGINS=https://vault.example.com

# Optional: path of the built web client Caddy serves at / (default
# ../../apps/web/dist; build it with `npm ci && npm --workspace apps/web run build`).
# WEB_DIST=../../apps/web/dist
