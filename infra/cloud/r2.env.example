# Storage variables only; use one set per Rails environment.
# Replace placeholders in your deployment secret store, never in tracked files.
# Private bucket: leave r2.dev and public custom-domain access disabled.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=my-secret-sandbox
# Production only: set S3_BUCKET=my-secret-production and use its own keys.
S3_ACCESS_KEY=CHANGE_ME_BUCKET_SCOPED_R2_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_BUCKET_SCOPED_R2_SECRET_KEY
# Leave S3_USE_AWS_ENDPOINT unset. Presigned URLs use the R2 S3 API domain.
# No vault/file/master/recovery keys or SSE-C keys belong in server settings.
